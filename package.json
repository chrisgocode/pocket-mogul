{
  "name": "pocket-mogul",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "test": "bun run test:logic && bun run test:screens",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --ignore-pattern 'lint-rules/fixtures/**'",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip:check && bun run test && bun run doctor",
    "test:logic": "bun test ./src/domain ./src/content ./src/application ./lint-rules/rules.test.ts",
    "test:screens": "jest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "knip:check": "knip",
    "doctor": "expo-doctor",
    "balance": "bun scripts/balance-report.ts"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "expo-doctor": "1.21.6",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.3"
}
